{
  "name": "silkboard-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fix": "prettier --write . && eslint . --fix",
    "check:all": "npm run check && npm run lint && npm run test:dependency-compat && npm run format:check && npm run test && npm run build",
    "test:dependency-compat": "node --test dependency-compat.test.mjs",
    "coverage": "vitest run --coverage",
    "dupes": "jscpd src",
    "test:browser": "playwright test",
    "test:handoff": "prettier --check ../deploy/owner-handoff && node --test --experimental-test-coverage --test-coverage-include='../deploy/owner-handoff/*.mjs' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 ../deploy/owner-handoff/tests/*.test.mjs",
    "test:bombyx": "prettier --check ../.bombyx ../dev/*.mjs && node --test --experimental-test-coverage --test-coverage-include='../.bombyx/*.mjs' --test-coverage-exclude='../.bombyx/*-cli.mjs' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 ../.bombyx/tests/*.test.mjs ../dev/cargo.test.mjs && npm run test:codex-title",
    "test:codex-title": "node --test --experimental-test-coverage --test-coverage-include='../dev/codex-title.mjs' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 ../dev/codex-title.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.46.4",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.6.0",
    "typescript": "^6.0.3",
    "vite": "8.1.6",
    "vitest": "4.1.12",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.12",
    "jscpd": "5.0.11",
    "marked": "18.1.0",
    "dompurify": "3.4.17",
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "undici": "7.30.1"
  }
}
