{
  "description": "Validate changed Rust, show Git status and optionally publish concise Codex progress.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/stop-check.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/bin/kozmotic\" codex-git-status",
            "timeout": 6
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/publish-progress.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/publish-progress.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/publish-progress.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
